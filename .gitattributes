# The compiled blocks are committed so Composer and zip installs need no Node.js build.
/build/** linguist-generated=true
/package-lock.json linguist-generated=true

# Keep development files out of Composer dist archives.
/.github export-ignore
/src export-ignore
/tests export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.nvmrc export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpcs.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/playwright.config.ts export-ignore
/playwright.screenshots.config.ts export-ignore
/tsconfig.json export-ignore
/vitest.config.mts export-ignore
/demo export-ignore
/docs export-ignore
