<?xml version="1.0"?>
<ruleset name="WP Newsroom Blocks">
	<description>WordPress and WordPress VIP coding standards for WP Newsroom Blocks.</description>

	<file>.</file>

	<!-- Generated, vendored or tooling output. The render.php files are linted in src/, not their build/ copies. -->
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/artifacts/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPressVIPMinimum"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-newsroom-blocks"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ManTek\NewsroomBlocks"/>
				<element value="wp_newsroom_blocks"/>
			</property>
		</properties>
	</rule>

	<!-- Classes live in PSR-4 style files (includes/ReadAlso.php), not class-*.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/includes/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Tests stub WordPress with Brain Monkey and use PHPUnit's naming. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Tests run on plain PHP without WordPress, so core's wrappers (wp_json_encode) do not exist there. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPressVIPMinimum.Files.IncludingFile">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
