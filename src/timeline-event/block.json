{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mantek/timeline-event",
	"version": "0.9.0",
	"title": "Timeline event",
	"category": "newsroom",
	"parent": [ "mantek/timeline" ],
	"description": "One dated moment in a story timeline.",
	"textdomain": "mantek-newsroom-blocks",
	"attributes": {
		"datetime": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-mantek-timeline-event__time",
			"default": ""
		},
		"heading": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-mantek-timeline-event__heading",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js"
}
